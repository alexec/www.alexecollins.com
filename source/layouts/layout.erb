<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google-site-verification" content="459WLyNfyiKwT7T3IzdCjzIpNP-IVQSOb4tR8b2vQhI">
    <title><%= current_page.data.title ? "#{current_page.data.title} - Alex Collins" : "Alex Collins" %></title>
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
    <link rel="stylesheet" href="/css/site.css">
    <style>
<%= Rouge::Themes::Github.render(:scope => '.highlight') %>
    </style>
  </head>
  <body class="<%= page_classes %>">
    <header class="site-header">
      <a class="site-brand" href="/">
        <img class="site-logo" src="/images/logo.svg" alt="" width="44" height="44">
        <span>
          <span class="site-title">Alex Collins</span>
          <span class="site-tagline">Software engineering</span>
        </span>
      </a>
      <nav class="site-nav">
        <a href="/">Home</a>
        <a href="/about-me/">About</a>
        <a href="/archive/">Archive</a>
      </nav>
    </header>

    <main>
<% if current_article %>
      <article class="post">
        <header class="post-header">
          <h1><%= current_article.title %></h1>
          <p class="meta">
            <time datetime="<%= current_article.date.strftime('%Y-%m-%d') %>"><%= current_article.date.strftime('%B %e, %Y') %></time>
            <% unless current_article.tags.empty? %>
              &middot;
              <% current_article.tags.each do |tag| %>
                <%= link_to tag, tag_path(tag) %>
              <% end %>
            <% end %>
          </p>
        </header>
        <%= yield %>
      </article>

      <% related = blog.articles.map {|a| {:a => a, :tags => (current_article.tags & a.tags)}}.find_all{|a| a[:tags].length>0}.sort{|a,b| b[:tags].length <=> a[:tags].length}.map{|a| a[:a]}.find_all{|a| a.title!=current_article.title}[0...5] %>
      <% if related.length > 0 %>
      <aside class="related">
        <h2>Related</h2>
        <ul>
          <% related.each do |article| %>
            <li><%= link_to article.title, article %></li>
          <% end %>
        </ul>
      </aside>
      <% end %>
<% else %>
      <% if current_page.data.title && current_page.url != '/' && !current_page.url.start_with?('/page/') %>
        <h1><%= current_page.data.title %></h1>
      <% end %>
      <%= yield %>
<% end %>
    </main>

    <footer class="site-footer">
      <p>&copy; <%= Date.today.year %> Alex Collins &middot; <a href="https://www.linkedin.com/in/alexecollins/">Contact me on LinkedIn</a></p>
    </footer>
  </body>
</html>
