---
pageable: true
---
<h1>Archive for
  <% case page_type
     when 'day' %>
    <%= Date.new(year, month, day).strftime('%b %e %Y') %>
  <% when 'month' %>
    <%= Date.new(year, month, 1).strftime('%b %Y') %>
  <% when 'year' %>
    <%= year %>
  <% end %>
</h1>

<ul>
  <% page_articles.each do |article| %>
    <li><%= link_to article.title, article %> <span class="meta"><%= article.date.strftime('%b %e, %Y') %></span></li>
  <% end %>
</ul>

<% if paginate && (prev_page || next_page) %>
<nav class="pagination">
  <% if prev_page %><%= link_to '&larr; Newer', prev_page %><% end %>
  <span class="spacer"></span>
  <% if next_page %><%= link_to 'Older &rarr;', next_page %><% end %>
</nav>
<% end %>
