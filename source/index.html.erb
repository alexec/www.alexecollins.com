---
title: Blog
---

<% recent = blog.articles.select {|a| a.date.to_date >= Date.today - 365 }.first(5) %>

<% if recent.empty? %>
  <p>Nothing new in the last year. Older posts are in the <a href="/archive/">archive</a>.</p>
<% else %>
<div class="post-list">
<% recent.each do |article| %>
  <article>
    <h2><%= link_to article.title, article %></h2>
    <p class="meta"><time datetime="<%= article.date.strftime('%Y-%m-%d') %>"><%= article.date.strftime('%B %e, %Y') %></time></p>
    <p><%= plain_summary(article) %></p>
  </article>
<% end %>
</div>
<p class="meta">Older posts are in the <a href="/archive/">archive</a>.</p>
<% end %>
